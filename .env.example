# Copy to .env for local development. Never commit .env.
# On Vercel these are set under Settings > Environment Variables (see README-CMS.md).

# Postgres (Neon on Vercel). Locally, any Postgres 14+:
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/precision_cms

# Media storage (Vercel Blob). Leave empty locally: uploads then go to ./media
BLOB_READ_WRITE_TOKEN=

# A long random string: openssl rand -hex 32
PAYLOAD_SECRET=

# The Vercel deploy hook the Publish website button calls
PUBLISH_HOOK_URL=

# The live address (leave unset on Vercel previews)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# First administrator, created once by the build or by npm run seed:admin
SEED_ADMIN_EMAIL=rowayne@gyaclients.com
SEED_ADMIN_PASSWORD=

# Enquiry form (SMTP2GO)
SMTP2GO_API_KEY=
ENQUIRY_FROM=website@precisiondentistry.com.au
ENQUIRY_RECIPIENTS=

# SmileOx (price list requests and enquiries). The intake address gets every lead by email.
SMILEOX_INTAKE_EMAIL=
# Optional: a SmileOx webhook for price list requests (JSON), and its bearer token
SMILEOX_WEBHOOK_URL=
SMILEOX_WEBHOOK_SECRET=
# Optional: who else gets price list requests (default: ENQUIRY_RECIPIENTS)
PRICE_LIST_RECIPIENTS=
