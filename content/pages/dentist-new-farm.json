        {
          "id": "f2",
          "label": "Heading",
          "type": "text",
          "value": "Frequently Asked Questions"
        },
        {
          "id": "f3",
          "label": "Question",
          "type": "text",
          "value": "At what age should my child first visit the dentist?",
          "group": "1"
        },
        {
          "id": "f4",
          "label": "Paragraph",
          "type": "text",
          "value": "We suggest a first visit around their first birthday or when the first teeth appear, whichever comes first.",
          "group": "1"
        },
        {
          "id": "f5",
          "label": "Question",
          "type": "text",
          "value": "Can I book my children&#x27;s appointments together?",
          "group": "2"
        },
        {
          "id": "f6",
          "label": "Paragraph",
          "type": "text",
          "value": "Where availability allows, we are happy to schedule siblings back to back. Let our team know when you call.",
          "group": "2"
        },
        {
          "id": "f7",
          "label": "Question",
          "type": "text",
          "value": "Can I stay with my child during their appointment?",
          "group": "3"
        },
        {
          "id": "f8",
          "label": "Paragraph",
          "type": "text",
          "value": "Yes. Parents and carers are welcome to stay with their child for the whole visit.",
          "group": "3"
        },
        {
          "id": "f9",
          "label": "Question",
          "type": "text",
          "value": "Is Invisalign suitable for teenagers?",
          "group": "4"
        },
        {
          "id": "f10",
          "label": "Paragraph",
          "type": "text",
          "value": "Many teenagers are suitable for clear aligners. We assess suitability at a consultation and explain the commitment involved.",
          "group": "4"
        },
        {
          "id": "f11",
          "label": "Question",
          "type": "text",
          "value": "My child chipped a tooth at the park. What should I do?",
          "group": "5"
        },
        {
          "id": "f12",
          "label": "Paragraph",
          "type": "text",
          "value": "Keep any broken pieces in milk, rinse your child&#x27;s mouth gently with water and call us as soon as possible.",
          "group": "5"
        },
        {
          "id": "f13",
          "label": "Question",
          "type": "text",
          "value": "Is parking available for families?",
          "group": "6"
        },
        {
          "id": "f14",
          "label": "Paragraph",
          "type": "text",
          "value": "Yes. Free on-site parking is available for patients during their appointment.",
          "group": "6"
        }
