      "altAuto": true,
      "alt": false,
      "label": "About Precision Dental",
      "pinned": false,
      "template": "<section class=\"body-section{{alt}}\"><div class=\"container split reveal\"><h2>{{f1}}</h2><div class=\"prose\"><p>{{f2}}</p>\n<p>{{f3}}</p></div></div></section>",
      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "About Precision Dental"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "New Farm has a strong neighbourhood feel, with young families, long-time locals and plenty of people who enjoy an active, outdoor lifestyle. We want visiting the dentist to feel just as relaxed. Our team takes time to get to know each patient and explains care in a warm, unhurried way."
        },
        {
          "id": "f3",
          "label": "Paragraph",
          "type": "text",
          "value": "Children are encouraged to explore the chair before we begin, and parents are always welcome to stay close by. For grown-ups who find appointments stressful, we move at a comfortable pace and check in often. Find out more About Precision Dental and the values that shape our care."
        }
      ]
    },
