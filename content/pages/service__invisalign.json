    {
      "key": "s3",
      "kind": "content",
      "before": "\n",
      "altAuto": true,
      "alt": false,
      "label": "What Is Invisalign?",
      "pinned": false,
      "template": "<section class=\"body-section{{alt}}\"><div class=\"container split reveal\"><h2>{{f1}}</h2><div class=\"prose\"><p>{{f2}}</p>\n<p>{{f3}}</p></div></div></section>",
      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "What Is Invisalign?"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "Invisalign is a clear aligner system that uses a sequence of custom-made, removable trays. Each set of aligners applies gentle, controlled pressure to move teeth a small amount. Every one to two weeks, you move on to the next set in the series, and your teeth gradually shift towards their planned position."
        },
        {
          "id": "f3",
          "label": "Paragraph",
          "type": "text",
          "value": "Treatment is planned digitally using a 3D scan of your teeth, which allows you to see a projected outline of how your teeth are expected to move. Small, tooth-coloured attachments are sometimes bonded to teeth to help the aligners grip and guide movement."
        }
      ]
    },
    {
      "key": "s4",
      "kind": "content",
      "before": "\n",
      "altAuto": true,
      "alt": true,
      "label": "Is Invisalign Right for You?",
      "pinned": false,
      "template": "<section class=\"body-section{{alt}}\"><div class=\"container split reveal\"><h2>{{f1}}</h2><div class=\"prose\"><p>{{f2}}</p>\n<ul class=\"check-list\"><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg><span>{{f3}}</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg><span>{{f4}}</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg><span>{{f5}}</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg><span>{{f6}}</span></li></ul>\n<p>{{f7}}</p>\n<p>{{f8}}</p></div></div></section>",
      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "Is Invisalign Right for You?"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "Invisalign may be suitable for teenagers and adults with:"
        },
        {
          "id": "f3",
          "label": "List item",
          "type": "text",
          "value": "Crowded or overlapping teeth"
        },
        {
          "id": "f4",
          "label": "List item",
          "type": "text",
          "value": "Gaps between teeth"
        },
        {
          "id": "f5",
          "label": "List item",
          "type": "text",
          "value": "Mild to moderate bite concerns"
        },
        {
          "id": "f6",
          "label": "List item",
          "type": "text",
          "value": "Teeth that have moved since previous orthodontic treatment"
        },
        {
          "id": "f7",
          "label": "Paragraph",
          "type": "text",
          "value": "Aligners must be worn for around 20 to 22 hours a day to be effective and should only be removed for eating, drinking anything other than water, and cleaning. If you feel this level of commitment would be difficult, or if your case is complex, we will discuss other options, including referral to an orthodontist where appropriate. Your teeth and gums need to be healthy before treatment begins."
        },
        {
          "id": "f8",
          "label": "Paragraph",
          "type": "text",
          "value": "Curious before you book? You can try Invisalign SmileView online to see a simulation of how your smile might look."
        }
      ]
    },
    {
      "key": "s5",
      "kind": "content",
      "before": "\n",
      "altAuto": true,
      "alt": false,
      "label": "What Happens at Your Appointment",
      "pinned": false,
      "template": "<section class=\"body-section{{alt}}\"><div class=\"container\"><h2>{{f1}}</h2><div class=\"steps\"><div class=\"step reveal\"><span class=\"n\"></span><div><h3>{{f2}}</h3><p>{{f3}}</p></div></div><div class=\"step reveal\"><span class=\"n\"></span><div><h3>{{f4}}</h3><p>{{f5}}</p></div></div><div class=\"step reveal\"><span class=\"n\"></span><div><h3>{{f6}}</h3><p>{{f7}}</p></div></div></div></div></section>",
      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "What Happens at Your Appointment"
        },
        {
          "id": "f2",
          "label": "Subheading",
          "type": "text",
          "value": "Consultation",
          "group": "1"
        },
        {
          "id": "f3",
          "label": "Paragraph",
          "type": "text",
          "value": "We examine your teeth, gums and bite, take photographs and digital X-rays, and talk about what you would like to achieve. If Invisalign is suitable, we explain the likely treatment length, costs and what is involved.",
          "group": "1"
        },
        {
          "id": "f4",
          "label": "Subheading",
          "type": "text",
          "value": "Digital Scan and Planning",
          "group": "2"
        },
        {
          "id": "f5",
          "label": "Paragraph",
          "type": "text",
          "value": "Using our 3D intra-oral scanner, we create an accurate digital model of your teeth without traditional impression putty. Your treatment is then planned, and you can review the proposed tooth movements before approving your aligners.",
          "group": "2"
        },
        {
          "id": "f6",
          "label": "Subheading",
          "type": "text",
          "value": "Fitting and Reviews",
          "group": "3"
        },
        {
          "id": "f7",
          "label": "Paragraph",
          "type": "text",
          "value": "When your aligners arrive, we fit the first set, place any attachments and show you how to insert, remove and clean your trays. You will then attend regular reviews so we can monitor your progress.",
          "group": "3"
        }
      ]
    },
    {
      "key": "s6",
      "kind": "content",
      "before": "\n",
      "altAuto": true,
      "alt": true,
      "label": "Aftercare and Ongoing Care",
      "pinned": false,
      "template": "<section class=\"body-section{{alt}}\"><div class=\"container split reveal\"><h2>{{f1}}</h2><div class=\"prose\"><p>{{f2}}</p></div></div></section>",
      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "Aftercare and Ongoing Care"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "Clean your aligners each morning and night, and brush your teeth before putting them back in. Store aligners in their case when not wearing them. Once active treatment is complete, retainers are essential to help keep your teeth in their new position. Teeth can move throughout life, so ongoing retainer wear is usually recommended."
        }
      ]
    },
    {
      "key": "s7",
      "kind": "content",
      "before": "\n",
      "altAuto": true,
      "alt": false,
      "label": "Why Choose Precision Dental for Invisalign",
      "pinned": false,
      "template": "<section class=\"body-section{{alt}}\"><div class=\"container reveal\"><h2>{{f1}}</h2><div class=\"prose\"><p>{{f2}}</p></div></div></section>",
      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "Why Choose Precision Dental for Invisalign"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "We combine a thorough assessment with digital scanning and planning, so you can see how treatment is expected to progress. Our team takes time to explain every stage, and payment plans are available through DentiCare for eligible patients."
        }
      ]
    },
    {
      "key": "s8",
      "kind": "content",
      "before": "\n",
      "altAuto": true,
      "alt": true,
      "label": "Fees, Health Funds and Payment Options",
      "pinned": false,
      "template": "<section class=\"body-section{{alt}}\"><div class=\"container split reveal\"><h2>{{f1}}</h2><div class=\"prose\"><p>{{f2}}</p></div></div></section>",
      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "Fees, Health Funds and Payment Options"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "The cost of your treatment depends on your individual needs. After your examination, we talk you through your options and the expected fees before any treatment begins. We accept most major health funds, process claims on the spot through HICAPS and are a preferred provider for {{site:preferredFunds}}. Payment plans are available through DentiCare for eligible patients, subject to terms and conditions. You can learn more on our Prices and Payment Options page."
        }
      ]
    },
