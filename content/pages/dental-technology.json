    {
      "key": "s3",
      "kind": "content",
      "before": "\n",
      "altAuto": true,
      "alt": false,
      "label": "Intra-Oral Camera",
      "pinned": false,
      "template": "<section class=\"body-section{{alt}}\"><div class=\"container split reveal\"><h2>{{f1}}</h2><div class=\"prose\"><p>{{f2}}</p></div></div></section>",
      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "Intra-Oral Camera"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "Our intra-oral camera is a small, pen-sized device that captures detailed images of your teeth and gums. Photos are displayed on a screen so you can see exactly what we see, which makes it easier to understand our findings and discuss your options."
        }
      ]
    },
    {
      "key": "s4",
      "kind": "content",
      "before": "\n",
      "altAuto": true,
      "alt": true,
      "label": "Digital X-Rays",
      "pinned": false,
      "template": "<section class=\"body-section{{alt}}\"><div class=\"container reveal\"><h2>{{f1}}</h2><div class=\"prose\"><p>{{f2}}</p></div></div></section>",
      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "Digital X-Rays"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "Digital X-ray sensors display images on screen almost instantly. They use a lower radiation dose than traditional film X-rays and allow images to be enlarged, helping us detect concerns such as decay between teeth and changes in the bone."
        }
      ]
    },
    {
      "key": "s5",
      "kind": "content",
      "before": "\n",
      "altAuto": true,
      "alt": false,
      "label": "Digital OPG",
      "pinned": false,
      "template": "<section class=\"body-section{{alt}}\"><div class=\"container split reveal\"><h2>{{f1}}</h2><div class=\"prose\"><p>{{f2}}</p></div></div></section>",
      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "Digital OPG"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "An OPG is a panoramic X-ray that shows all your teeth, both jaws and surrounding structures in a single image. It is particularly helpful when assessing wisdom teeth, planning dental implants, evaluating gum disease and bone levels, and investigating jaw joint concerns."
        }
      ]
    },
    {
      "key": "s6",
      "kind": "content",
      "before": "\n",
      "altAuto": true,
      "alt": true,
      "label": "DiagnoCam",
      "pinned": false,
      "template": "<section class=\"body-section{{alt}}\"><div class=\"container reveal\"><h2>{{f1}}</h2><div class=\"prose\"><p>{{f2}}</p></div></div></section>",
      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "DiagnoCam"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "DiagnoCam uses light rather than radiation to help detect decay between teeth and beneath fillings. It is a useful addition to our diagnostic tools, particularly for monitoring early changes over time."
        }
      ]
    },
    {
      "key": "s7",
      "kind": "content",
      "before": "\n",
      "altAuto": true,
      "alt": false,
      "label": "3D Intra-Oral Scanner",
      "pinned": false,
      "template": "<section class=\"body-section{{alt}}\"><div class=\"container reveal\"><h2>{{f1}}</h2><div class=\"prose\"><p>{{f2}}</p></div></div></section>",
      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "3D Intra-Oral Scanner"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "Our 3D intra-oral scanner captures a detailed digital model of your teeth without traditional impression putty. Scans are used for crowns, splints, mouthguards and Invisalign treatment planning."
        }
      ]
    },
    {
      "key": "s8",
      "kind": "content",
      "before": "\n",
      "altAuto": true,
      "alt": true,
      "label": "CEREC",
      "pinned": false,
      "template": "<section class=\"body-section{{alt}}\"><div class=\"container reveal\"><h2>{{f1}}</h2><div class=\"prose\"><p>{{f2}}</p></div></div></section>",
      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "CEREC"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "CEREC allows ceramic crowns, inlays and onlays to be designed and milled within our practice. In many cases, this means a restoration can be completed in a single appointment, without a temporary."
        }
      ]
    },
    {
      "key": "s9",
      "kind": "content",
      "before": "\n",
      "altAuto": true,
      "alt": false,
      "label": "Digital Smile Design",
      "pinned": false,
      "template": "<section class=\"body-section{{alt}}\"><div class=\"container reveal\"><h2>{{f1}}</h2><div class=\"prose\"><p>{{f2}}</p></div></div></section>",
      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "Digital Smile Design"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "Digital Smile Design uses photographs, video and digital planning to analyse your facial and dental features. It helps us plan cosmetic treatment, such as porcelain veneers, and allows you to visualise proposed changes before treatment begins."
        }
      ]
    },
    {
      "key": "s10",
      "kind": "content",
      "before": "\n",
      "altAuto": true,
      "alt": true,
      "label": "Rotary Endodontics",
      "pinned": false,
      "template": "<section class=\"body-section{{alt}}\"><div class=\"container reveal\"><h2>{{f1}}</h2><div class=\"prose\"><p>{{f2}}</p></div></div></section>",
      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "Rotary Endodontics"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "Engine-driven rotary instruments help us clean and shape root canals efficiently and consistently, particularly in narrow or curved canals, supporting careful root canal therapy."
        }
      ]
    },
    {
      "key": "s11",
      "kind": "content",
      "before": "\n",
      "altAuto": true,
      "alt": false,
      "label": "Patient Education Software",
      "pinned": false,
      "template": "<section class=\"body-section{{alt}}\"><div class=\"container reveal\"><h2>{{f1}}</h2><div class=\"prose\"><p>{{f2}}</p></div></div></section>",
      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "Patient Education Software"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "Our practice software securely stores your records, digital images and treatment history in one place. It also includes patient education videos and animations that help explain procedures clearly."
        }
      ]
    },
    {
      "key": "s12",
      "kind": "content",
      "before": "\n",
      "altAuto": true,
      "alt": true,
      "label": "Comfort Features",
      "pinned": false,
      "template": "<section class=\"body-section{{alt}}\"><div class=\"container reveal\"><h2>{{f1}}</h2><div class=\"prose\"><p>{{f2}}</p></div></div></section>",
      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "Comfort Features"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "Our treatment rooms include memory-foam dental chairs, ceiling-mounted televisions and noise-cancelling headphones. Together with happy gas, these features help our anxious patients feel more at ease."
        }
      ]
    },
