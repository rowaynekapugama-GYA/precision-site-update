        {
          "id": "f2",
          "label": "Heading",
          "type": "text",
          "value": "Frequently Asked Questions"
        },
        {
          "id": "f3",
          "label": "Question",
          "type": "text",
          "value": "My filling fell out. How soon should I be seen?",
          "group": "1"
        },
        {
          "id": "f4",
          "label": "Paragraph",
          "type": "text",
          "value": "Ideally within a day or two, or sooner if you have pain. Keep the area clean and avoid chewing on that side until your appointment.",
          "group": "1"
        },
        {
          "id": "f5",
          "label": "Question",
          "type": "text",
          "value": "What should I do about a toothache before my visit?",
          "group": "2"
        },
        {
          "id": "f6",
          "label": "Paragraph",
          "type": "text",
          "value": "Rinse with warm water, floss gently around the tooth and take over-the-counter pain relief as directed if suitable. Call us for an appointment.",
          "group": "2"
        },
        {
          "id": "f7",
          "label": "Question",
          "type": "text",
          "value": "Do I need my wisdom teeth out?",
          "group": "3"
        },
        {
          "id": "f8",
          "label": "Paragraph",
          "type": "text",
          "value": "Not always. We assess their position with a digital OPG and advise whether monitoring or removal is more appropriate.",
          "group": "3"
        },
        {
          "id": "f9",
          "label": "Question",
          "type": "text",
          "value": "Can I visit after work?",
          "group": "4"
        },
        {
          "id": "f10",
          "label": "Paragraph",
          "type": "text",
          "value": "Yes. We are open until 7pm on Tuesdays, and our team can help find other suitable times.",
          "group": "4"
        },
        {
          "id": "f11",
          "label": "Question",
          "type": "text",
          "value": "How much does an emergency visit cost?",
          "group": "5"
        },
        {
          "id": "f12",
          "label": "Paragraph",
          "type": "text",
          "value": "It depends on the examination, any imaging and the treatment required. We explain expected fees before we start.",
          "group": "5"
        },
        {
          "id": "f13",
          "label": "Question",
          "type": "text",
          "value": "Can I claim my check-up on the spot?",
          "group": "6"
        },
        {
          "id": "f14",
          "label": "Paragraph",
          "type": "text",
          "value": "Yes. We process most health fund claims at the time of your visit using HICAPS.",
          "group": "6"
        }
      ]
