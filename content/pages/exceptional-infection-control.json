      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "How We Protect Our Patients and Team"
        },
        {
          "id": "f2",
          "label": "Subheading",
          "type": "text",
          "value": "Instrument Sterilisation"
        },
        {
          "id": "f3",
          "label": "Paragraph",
          "type": "text",
          "value": "Reusable instruments are cleaned, packaged and sterilised in an autoclave, which uses high-pressure steam. Sterilisation cycles are monitored and recorded."
        },
        {
          "id": "f4",
          "label": "Subheading",
          "type": "text",
          "value": "Single-Use Items"
        },
        {
          "id": "f5",
          "label": "Paragraph",
          "type": "text",
          "value": "Wherever practical, we use single-use, disposable items that are discarded after each patient."
        },
        {
          "id": "f6",
          "label": "Subheading",
          "type": "text",
          "value": "Surface Decontamination"
        },
        {
          "id": "f7",
          "label": "Paragraph",
          "type": "text",
          "value": "Treatment rooms, dental chairs and surfaces are thoroughly cleaned and disinfected between every patient."
        },
        {
          "id": "f8",
          "label": "Subheading",
          "type": "text",
          "value": "Personal Protective Equipment"
        },
        {
          "id": "f9",
          "label": "Paragraph",
          "type": "text",
          "value": "Our clinical team wears gloves, masks, protective eyewear and gowns as appropriate. We also provide protective eyewear for patients during treatment."
        },
        {
          "id": "f10",
          "label": "Subheading",
          "type": "text",
          "value": "Dental Water Quality"
        },
        {
          "id": "f11",
          "label": "Paragraph",
          "type": "text",
          "value": "Water used in our dental equipment is managed and filtered to maintain water quality during treatment."
        },
        {
          "id": "f12",
          "label": "Subheading",
          "type": "text",
          "value": "Training and Review"
        },
        {
          "id": "f13",
          "label": "Paragraph",
          "type": "text",
          "value": "Our team is trained in infection prevention and control, and our procedures are regularly reviewed in line with Dental Board of Australia guidelines and Australian standards."
        }
      ]
    },
