        {
          "id": "f2",
          "label": "Heading",
          "type": "text",
          "value": "Frequently Asked Questions"
        },
        {
          "id": "f3",
          "label": "Question",
          "type": "text",
          "value": "How close is Precision Dental to Bowen Hills?",
          "group": "1"
        },
        {
          "id": "f4",
          "label": "Paragraph",
          "type": "text",
          "value": "Bowen Hills borders Fortitude Valley, and our practice is at {{site:addressStreet}}. For many residents and workers, it is a short trip.",
          "group": "1"
        },
        {
          "id": "f5",
          "label": "Question",
          "type": "text",
          "value": "Can I park at the practice?",
          "group": "2"
        },
        {
          "id": "f6",
          "label": "Paragraph",
          "type": "text",
          "value": "Yes. Patients can use free on-site parking at HQ South Tower for the length of their appointment.",
          "group": "2"
        },
        {
          "id": "f7",
          "label": "Question",
          "type": "text",
          "value": "How long does a same-day crown appointment take?",
          "group": "3"
        },
        {
          "id": "f8",
          "label": "Paragraph",
          "type": "text",
          "value": "A CEREC crown visit usually takes a few hours, covering preparation, design, milling and fitting. We will give you an estimate when booking.",
          "group": "3"
        },
        {
          "id": "f9",
          "label": "Question",
          "type": "text",
          "value": "I clench my teeth when I am stressed. What can you do?",
          "group": "4"
        },
        {
          "id": "f10",
          "label": "Paragraph",
          "type": "text",
          "value": "We can check for signs of wear or cracks and, if appropriate, make a custom night splint from a digital scan of your teeth to help protect them.",
          "group": "4"
        },
        {
          "id": "f11",
          "label": "Question",
          "type": "text",
          "value": "Can I book a check-up during my lunch break?",
          "group": "5"
        },
        {
          "id": "f12",
          "label": "Paragraph",
          "type": "text",
          "value": "Many check-ups take between 30 and 60 minutes, depending on your needs. Call our team, and we will help find a time that fits your day.",
          "group": "5"
        },
        {
          "id": "f13",
          "label": "Question",
          "type": "text",
          "value": "What happens if I need an urgent appointment?",
          "group": "6"
        },
        {
          "id": "f14",
          "label": "Paragraph",
          "type": "text",
          "value": "Call us as early as possible. We set aside time for urgent care and will do our best to see you that day.",
          "group": "6"
        }
      ]
    },
