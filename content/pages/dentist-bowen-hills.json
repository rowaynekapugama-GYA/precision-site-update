      "kind": "content",
      "before": "\n",
      "altAuto": true,
      "alt": false,
      "label": "About Precision Dental",
      "pinned": false,
      "template": "<section class=\"body-section{{alt}}\"><div class=\"container split reveal\"><h2>{{f1}}</h2><div class=\"prose\"><p>{{f2}}</p>\n<p>{{f3}}</p></div></div></section>",
      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "About Precision Dental"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "Bowen Hills blends office towers, apartment living and the busy Brisbane Showgrounds precinct, and our patients here tend to want care that is efficient without feeling rushed. We aim to keep appointments running to time, explain every finding in clear terms and make it simple to book a visit around your working week."
        },
        {
          "id": "f3",
          "label": "Paragraph",
          "type": "text",
          "value": "Once you are settled in the chair, a ceiling-mounted screen and noise-cancelling headphones help the time pass comfortably. Our intra-oral camera lets you see your teeth on screen as we examine them, so you always understand what we are recommending and why. Learn more About Precision Dental and the principles that guide our team."
        }
      ]
    },
    {
