        },
        {
          "id": "f2",
          "label": "Subheading",
          "type": "text",
          "value": "Honesty"
        },
        {
          "id": "f3",
          "label": "Paragraph",
          "type": "text",
          "value": "Cosmetic treatment should never be sold. We explain the benefits, limitations and costs of each option so you can decide in your own time."
        },
        {
          "id": "f4",
          "label": "Subheading",
          "type": "text",
          "value": "Comfort"
        },
        {
          "id": "f5",
          "label": "Paragraph",
          "type": "text",
          "value": "Noise-cancelling headphones and a relaxed pace make longer appointments more comfortable, and we pause whenever you need a break."
        },
        {
          "id": "f6",
          "label": "Subheading",
          "type": "text",
          "value": "Quality"
        },
        {
          "id": "f7",
          "label": "Paragraph",
          "type": "text",
          "value": "Digital planning, including Digital Smile Design where appropriate, helps us map out cosmetic and restorative care with precision."
        },
        {
          "id": "f8",
          "label": "Subheading",
          "type": "text",
          "value": "Convenience"
        },
        {
          "id": "f9",
          "label": "Paragraph",
          "type": "text",
          "value": "Early starts on Fridays, late finishes on Tuesdays and same-day crowns in many cases help you spend less time away from your desk."
        },
        {
          "id": "f10",
          "label": "Subheading",
          "type": "text",
          "value": "Safety"
        },
        {
          "id": "f11",
          "label": "Paragraph",
          "type": "text",
          "value": "Our infection prevention and control procedures are regularly reviewed as part of our practice accreditation."
        }
