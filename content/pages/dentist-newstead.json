      "kind": "content",
      "before": "\n",
      "altAuto": true,
      "alt": false,
      "label": "About Precision Dental",
      "pinned": false,
      "template": "<section class=\"body-section{{alt}}\"><div class=\"container split reveal\"><h2>{{f1}}</h2><div class=\"prose\"><p>{{f2}}</p>\n<p>{{f3}}</p></div></div></section>",
      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "About Precision Dental"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "Newstead has grown into one of Brisbane&#x27;s liveliest riverside neighbourhoods, and many of the people who live and work here juggle full calendars. We respect that. Our team keeps you informed about timing before treatment starts, and we plan longer courses of care in stages that suit your commitments."
        },
        {
          "id": "f3",
          "label": "Paragraph",
          "type": "text",
          "value": "Our treatment rooms are equipped with digital imaging and a 3D intra-oral scanner, so records can be taken quickly and without traditional impression putty. You can read more About Precision Dental and how we approach every patient."
        }
      ]
    },
