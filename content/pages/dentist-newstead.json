      "fields": [
        {
          "id": "f1",
          "label": "Small label",
          "type": "text",
          "value": "FAQ"
        },
        {
          "id": "f2",
          "label": "Heading",
          "type": "text",
          "value": "Frequently Asked Questions"
        },
        {
          "id": "f3",
          "label": "Question",
          "type": "text",
          "value": "How long does Invisalign treatment usually take?",
          "group": "1"
        },
        {
          "id": "f4",
          "label": "Paragraph",
          "type": "text",
          "value": "It depends on how much movement your teeth need. We give you an estimated timeframe after assessing your teeth and bite.",
          "group": "1"
        },
        {
          "id": "f5",
          "label": "Question",
          "type": "text",
          "value": "Will people notice I am wearing aligners?",
          "group": "2"
        },
        {
          "id": "f6",
          "label": "Paragraph",
          "type": "text",
          "value": "Clear aligners are designed to be discreet, and tooth-coloured attachments help them blend in during everyday conversation.",
          "group": "2"
        },
        {
          "id": "f7",
          "label": "Question",
          "type": "text",
          "value": "Can I whiten my teeth before an event?",
          "group": "3"
        },
        {
          "id": "f8",
          "label": "Paragraph",
          "type": "text",
          "value": "Professional whitening may suit you if your teeth and gums are healthy. Book an assessment well ahead of the date so we can plan the right approach.",
          "group": "3"
        },
        {
          "id": "f9",
          "label": "Question",
          "type": "text",
          "value": "Do I need two appointments for a crown?",
          "group": "4"
        },
        {
          "id": "f10",
          "label": "Paragraph",
          "type": "text",
          "value": "Not always. Many crowns can be completed in one visit with CEREC, although some cases are better suited to a dental laboratory.",
          "group": "4"
        },
        {
          "id": "f11",
          "label": "Question",
          "type": "text",
          "value": "Can I get an early appointment?",
          "group": "5"
        },
        {
          "id": "f12",
          "label": "Paragraph",
          "type": "text",
          "value": "Yes. We open at 8am on Fridays, and our team can suggest other times that fit around work.",
          "group": "5"
        },
        {
          "id": "f13",
          "label": "Question",
          "type": "text",
          "value": "Are cosmetic treatments covered by health funds?",
          "group": "6"
        },
        {
          "id": "f14",
          "label": "Paragraph",
          "type": "text",
          "value": "Some extras policies provide rebates for certain cosmetic or restorative items. We can supply item numbers so you can check with your fund.",
          "group": "6"
        }
      ]
    },
