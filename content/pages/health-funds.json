      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "Child Dental Benefits Schedule (CDBS)"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "The Child Dental Benefits Schedule is an Australian Government program that helps eligible families with the cost of basic dental care for their children."
        },
        {
          "id": "f3",
          "label": "Subheading",
          "type": "text",
          "value": "Who is eligible"
        },
        {
          "id": "f4",
          "label": "Paragraph",
          "type": "text",
          "value": "A child can use the CDBS if they are:"
        },
        {
          "id": "f5",
          "label": "List item",
          "type": "text",
          "value": "Aged 0 to 17 for at least one day of the calendar year"
        },
        {
          "id": "f6",
          "label": "List item",
          "type": "text",
          "value": "Eligible for Medicare"
        },
        {
          "id": "f7",
          "label": "List item",
          "type": "text",
          "value": "Receiving an eligible Australian Government payment, or with a parent or guardian who receives Family Tax Benefit Part A or another eligible payment"
        },
        {
          "id": "f8",
          "label": "Subheading",
          "type": "text",
          "value": "What the benefit covers"
        },
        {
          "id": "f9",
          "label": "Paragraph",
          "type": "text",
          "value": "Eligible children can receive up to $1,158 in benefits over two consecutive calendar years, for children whose two-year period starts in 2026. The cap is indexed each year, and eligibility is set by Services Australia. The CDBS covers basic dental services, including:"
        },
        {
          "id": "f10",
          "label": "List item",
          "type": "text",
          "value": "Check-ups"
        },
        {
          "id": "f11",
          "label": "List item",
          "type": "text",
          "value": "X-rays"
        },
        {
          "id": "f12",
          "label": "List item",
          "type": "text",
          "value": "Cleans"
        },
        {
          "id": "f13",
          "label": "List item",
          "type": "text",
          "value": "Fissure sealants"
        },
        {
          "id": "f14",
          "label": "List item",
          "type": "text",
          "value": "Fillings"
        },
        {
          "id": "f15",
          "label": "List item",
          "type": "text",
          "value": "Root canals"
        },
        {
          "id": "f16",
          "label": "List item",
          "type": "text",
          "value": "Extractions"
        },
        {
          "id": "f17",
          "label": "List item",
          "type": "text",
          "value": "Partial dentures"
        },
        {
          "id": "f18",
          "label": "Subheading",
          "type": "text",
          "value": "What it does not cover"
        },
        {
          "id": "f19",
          "label": "List item",
          "type": "text",
          "value": "Orthodontics, such as braces"
        },
        {
          "id": "f20",
          "label": "List item",
          "type": "text",
          "value": "Cosmetic dentistry"
        },
        {
          "id": "f21",
          "label": "List item",
          "type": "text",
          "value": "Dental treatment in hospital"
        },
        {
          "id": "f22",
          "label": "Subheading",
          "type": "text",
          "value": "How to access it"
        },
        {
          "id": "f23",
          "label": "Paragraph",
          "type": "text",
          "value": "You can check your child&#x27;s eligibility through your Medicare online account in myGov, or with Services Australia. Please bring your child&#x27;s Medicare card to the appointment, and our team will confirm their eligibility and remaining balance before treatment begins."
        },
        {
          "id": "f24",
          "label": "Note",
          "type": "text",
          "value": "Benefit amounts and eligibility are set by the Australian Government and may change. Please contact us or Services Australia to confirm your child&#x27;s eligibility."
        }
      ]
    },
