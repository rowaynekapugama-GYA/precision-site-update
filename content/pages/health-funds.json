      "fields": [
        {
          "id": "f1",
          "label": "Heading",
          "type": "text",
          "value": "Child Dental Benefits Schedule (CDBS)"
        },
        {
          "id": "f2",
          "label": "Paragraph",
          "type": "text",
          "value": "The Child Dental Benefits Schedule is a government-funded Medicare program that helps cover the cost of basic dental services for eligible children aged 0 to 17."
        },
        {
          "id": "f3",
          "label": "Subheading",
          "type": "text",
          "value": "Who is eligible"
        },
        {
          "id": "f4",
          "label": "Paragraph",
          "type": "text",
          "value": "Generally, a child is eligible if they are:"
        },
        {
          "id": "f5",
          "label": "List item",
          "type": "text",
          "value": "Aged 0 to 17 at any point in the calendar year"
        },
        {
          "id": "f6",
          "label": "List item",
          "type": "text",
          "value": "Eligible for Medicare"
        },
        {
          "id": "f7",
          "label": "List item",
          "type": "text",
          "value": "Receiving Family Tax Benefit Part A or another relevant Australian Government payment at some point in the year, or with a parent, carer or guardian who does"
        },
        {
          "id": "f8",
          "label": "Subheading",
          "type": "text",
          "value": "What the benefit covers"
        },
        {
          "id": "f9",
          "label": "Paragraph",
          "type": "text",
          "value": "Eligible children can receive up to $1,158 in benefits over two consecutive calendar years when their two-year period starts in 2026. For children whose period started in 2025, the cap is $1,132. The cap is indexed each year and depends on eligibility."
        },
        {
          "id": "f10",
          "label": "Paragraph",
          "type": "text",
          "value": "The CDBS covers basic dental services, such as:"
        },
        {
          "id": "f11",
          "label": "List item",
          "type": "text",
          "value": "Examinations"
        },
        {
          "id": "f12",
          "label": "List item",
          "type": "text",
          "value": "X-rays"
        },
        {
          "id": "f13",
          "label": "List item",
          "type": "text",
          "value": "Cleaning"
        },
        {
          "id": "f14",
          "label": "List item",
          "type": "text",
          "value": "Fluoride treatment"
        },
        {
          "id": "f15",
          "label": "List item",
          "type": "text",
          "value": "Fissure sealants"
        },
        {
          "id": "f16",
          "label": "List item",
          "type": "text",
          "value": "Fillings"
        },
        {
          "id": "f17",
          "label": "List item",
          "type": "text",
          "value": "Root canals"
        },
        {
          "id": "f18",
          "label": "List item",
          "type": "text",
          "value": "Extractions"
        },
        {
          "id": "f19",
          "label": "List item",
          "type": "text",
          "value": "Partial dentures"
        },
        {
          "id": "f20",
          "label": "Subheading",
          "type": "text",
          "value": "What it does not cover"
        },
        {
          "id": "f21",
          "label": "List item",
          "type": "text",
          "value": "Orthodontic treatment, such as braces"
        },
        {
          "id": "f22",
          "label": "List item",
          "type": "text",
          "value": "Cosmetic treatment"
        },
        {
          "id": "f23",
          "label": "List item",
          "type": "text",
          "value": "Services provided in hospital"
        },
        {
          "id": "f24",
          "label": "Subheading",
          "type": "text",
          "value": "How to access it"
        },
        {
          "id": "f25",
          "label": "Paragraph",
          "type": "text",
          "value": "You can check your child&#x27;s eligibility and remaining balance through your Medicare online account in myGov (select History and statements, then Child Dental Benefits Schedule). You can also ask our team at the appointment, and we will check for you."
        },
        {
          "id": "f26",
          "label": "Paragraph",
          "type": "text",
          "value": "Please bring your child&#x27;s Medicare card to the appointment."
        },
        {
          "id": "f27",
          "label": "Paragraph",
          "type": "text",
          "value": "Ask our team how CDBS billing works at our practice."
        },
        {
          "id": "f28",
          "label": "Link address",
          "type": "link",
          "value": "https://www.servicesaustralia.gov.au/child-dental-benefits-schedule",
          "group": "more"
        },
        {
          "id": "f29",
          "label": "Link text",
          "type": "text",
          "value": "Child Dental Benefits Schedule on the Services Australia website",
          "group": "more"
        },
        {
          "id": "f30",
          "label": "Small print",
          "type": "text",
          "value": "Benefit amounts and eligibility are set by the Australian Government and may change. Please contact us or Services Australia to confirm your child&#x27;s eligibility."
        }
      ]
