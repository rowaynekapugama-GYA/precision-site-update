{
  "key": "contact",
  "label": "Enquiry form and map",
  "template": "<section class=\"contact\" id=\"contact\">\n  <div class=\"container contact-grid\">\n    <div class=\"form-card reveal-left\">\n      <span class=\"pill\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4\"/></svg>{{f1}}</span>\n      <h3>{{f2}}</h3>\n      <p>{{f3}}</p>\n      <form class=\"form-grid\" id=\"enquiryForm\" action=\"/api/enquiry\" method=\"post\" novalidate>\n        <div class=\"field\"><label for=\"f-name\">{{f4}}</label><input id=\"f-name\" name=\"name\" type=\"text\" autocomplete=\"name\" required></div>\n        <div class=\"field\"><label for=\"f-phone\">{{f5}}</label><input id=\"f-phone\" name=\"phone\" type=\"tel\" autocomplete=\"tel\" required></div>\n        <div class=\"field full\"><label for=\"f-email\">{{f6}}</label><input id=\"f-email\" name=\"email\" type=\"email\" autocomplete=\"email\" required></div>\n        <div class=\"field full\"><label for=\"f-service\">{{f7}}</label>\n          <select id=\"f-service\" name=\"service\"><option>{{f8}}</option><option>{{f9}}</option><option>{{f10}}</option><option>{{f11}}</option><option>{{f12}}</option><option>{{f13}}</option></select></div>\n        <div class=\"field full\"><label for=\"f-msg\">{{f14}}</label><textarea id=\"f-msg\" name=\"message\"></textarea></div>\n        <label class=\"consent full\"><input type=\"checkbox\" required> <span>{{f15}}</span></label>\n        <p class=\"form-status\" id=\"formStatus\" role=\"status\" aria-live=\"polite\"></p>\n        <div class=\"full\"><button class=\"btn btn-dark\" type=\"submit\" id=\"formSubmit\">{{f16}} <span class=\"arr\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></button></div>\n      </form>\n    </div>\n    <div class=\"map-card reveal-right\">\n      <iframe title=\"Map showing Precision Dental at {{site:street}}, {{site:suburb}}\" src=\"{{site:mapEmbed}}\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" allowfullscreen></iframe>\n      <div class=\"map-info\">\n        <div><strong>{{f17}}</strong><p>{{site:addressLines}}</p>{{site:mapServiceArea}}</div>\n        <div><strong>{{f18}}</strong><p><a href=\"tel:{{site:phoneTel}}\">{{site:phone}}</a><br><a href=\"mailto:{{site:email}}\">{{site:email}}</a><br>{{site:parking}}</p></div>\n      </div>\n    </div>\n  </div>\n</section>",
